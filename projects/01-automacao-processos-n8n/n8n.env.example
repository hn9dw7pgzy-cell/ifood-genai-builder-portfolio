### Endpoint compatível com a API de chat escolhida
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

### Segredo local — nunca comitar este valor
OPENAI_API_KEY=

### Opcional para instalação local persistente do n8n
# N8N_ENCRYPTION_KEY=gere-uma-chave-longa-e-aleatoria
